final class SingletonSortedNumericDocValues extends SortedNumericDocValues {
    private final NumericDocValues in;

    SingletonSortedNumericDocValues(NumericDocValues in) {
        if (in.docID() != -1) {
            throw new IllegalStateException("iterator has already been used");
        }
        this.in = in;
    }

    @Override
    public int nextDoc() throws IOException {
        return in.nextDoc();
    }

    @Override
    public int advance(int target) throws IOException {
        return in.advance(target);
    }

    @Override
    public void rangeIntoBitSet(int from, int to, long min, long max, FixedBitSet bits, int off)
            throws IOException {
        in.rangeIntoBitSet(from, to, min, max, bits, off);
    }

    @Override
    public long cost() {
        return in.cost();
    }

    @Override
    public long nextValue() throws IOException {
        return in.longValue();
    }

    @Override
    public int docValueCount() {
        return 1;
    }
}
